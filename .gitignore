# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# service worker generado por Serwist a partir de app/sw.ts (ver next.config.ts)
/public/sw.js

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# personal chat exports (not part of the app)
/Con Caro🏡/
/Con Caro🏡.zip
/🏡 haganlo x ellos/
/🏡 haganlo x ellos.zip

# export de D:\Casa (datos reales, comentarios/contactos) + script de
# import puntual — no es parte de la app, se usa una vez y listo
/migracion/

# local dev data store (fallback when no Redis is configured)
/.data/

# credenciales bajadas a mano (Google OAuth client secret, etc.) —
# nunca al repo, van como variables de entorno en Vercel
/credentials/

# Herramientas y pruebas locales de cada uno — no van al repo (SEP23-13,
